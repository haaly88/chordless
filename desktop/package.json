{
  "name": "chordless-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Chordless desktop shell (Electron) — embeds the Chordless Node server and serves the built web UI.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chordless.desktop",
    "productName": "Chordless",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      { "from": "../server", "to": "server" },
      { "from": "../web/dist", "to": "web/dist" }
    ]
  }
}
