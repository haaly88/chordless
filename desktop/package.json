{
  "name": "chordless-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Chordless desktop shell (Electron) — embeds the Chordless Node server and serves the built web UI.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.chordless.desktop",
    "productName": "Chordless",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server"
      },
      {
        "from": "../node_modules",
        "to": "node_modules"
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      }
    ]
  }
}
