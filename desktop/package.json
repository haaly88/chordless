{
  "name": "chordless-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Chordless desktop shell (Electron) — embeds the Chordless Node server and serves the built web UI.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.chordless.desktop",
    "productName": "Chordless",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "haaly88",
      "repo": "chordless",
      "releaseType": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server"
      },
      {
        "from": "../node_modules",
        "to": "node_modules"
      },
      {
        "from": "build/yt-dlp",
        "to": "yt-dlp"
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      }
    ]
  }
}
